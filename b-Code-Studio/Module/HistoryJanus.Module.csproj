<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\JanusVersion.props" />

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HistoryJanus</AssemblyName>
    <RootNamespace>HistoryJanus.Module</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573;CS1591</NoWarn>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPackageRoot>
    <HistoryVulcanHostRoot Condition="'$(HistoryVulcanHostRoot)' == ''">$(HistoryVulcanPackageRoot)\host</HistoryVulcanHostRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HistoryVulcan.Services">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Services.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The module is UI-framework agnostic. Aurora pulls the serialized page
       description through janus.ui.describe and owns all WPF construction. -->
  <ItemGroup>
    <Compile Include="..\StudioBusinessComposition.cs" Link="StudioBusinessComposition.cs" />
    <Compile Include="..\Git\**\*.cs" Link="Git\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\GitHub\**\*.cs" Link="GitHub\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Views\**\*.cs"
             Link="Views\%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="..\Views\**\*.xaml"
          Link="Views\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="module.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Smoke" />
    <InternalsVisibleTo Include="Contracts" />
  </ItemGroup>
</Project>
