<Project>
  <PropertyGroup>
    <HistoryJanusVersion>5.3.1</HistoryJanusVersion>
    <!-- Janus 消费的 HistoryVulcan 正式宿主版本。这是宿主契约的唯一真源：
         发布脚本与质量门禁都从此读取，不再各自硬编码字面量。 -->
    <MinimumHistoryVulcanVersion>4.4.0</MinimumHistoryVulcanVersion>
    <VersionPrefix>$(HistoryJanusVersion)</VersionPrefix>
    <Version>$(HistoryJanusVersion)</Version>
    <AssemblyVersion>$(HistoryJanusVersion).0</AssemblyVersion>
    <FileVersion>$(HistoryJanusVersion).0</FileVersion>
    <InformationalVersion>$(HistoryJanusVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
