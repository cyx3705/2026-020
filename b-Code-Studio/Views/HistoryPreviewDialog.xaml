<Window x:Class="HistoryJanus.Views.HistoryPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860" Height="640" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Shell.Brush.Surface}"
        Foreground="{DynamicResource Shell.Brush.TextPrimary}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="关闭" Padding="16,4" Margin="0,8,0,0"
                HorizontalAlignment="Right" IsCancel="True" />
        <TextBox x:Name="ContentBox"
                 Background="{DynamicResource Shell.Brush.SurfaceAlt}"
                 Foreground="{DynamicResource Shell.Brush.TextPrimary}"
                 BorderBrush="{DynamicResource Shell.Brush.ControlBorder}"
                 IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
    </DockPanel>
</Window>
