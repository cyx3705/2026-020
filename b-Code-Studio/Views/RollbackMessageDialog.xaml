<Window x:Class="HistoryJanus.Views.RollbackMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="生成恢复提交" Width="520" Height="190" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Shell.Brush.Surface}"
        Foreground="{DynamicResource Shell.Brush.TextPrimary}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TargetText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="恢复提交说明"
                   Foreground="{DynamicResource Shell.Brush.TextSecondary}" Margin="0,10,0,4" />
        <TextBox Grid.Row="2" x:Name="MessageBox" VerticalContentAlignment="Center"
                 TextChanged="OnMessageChanged" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Padding="14,4" IsCancel="True" />
            <Button x:Name="ConfirmButton" Content="继续" Padding="14,4" Margin="8,0,0,0"
                    IsDefault="True" Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
