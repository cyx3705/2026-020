<UserControl x:Class="HistoryJanus.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Shell.Brush.Surface}"
             Foreground="{DynamicResource Shell.Brush.TextPrimary}">
    <Border BorderBrush="{DynamicResource Shell.Brush.Hairline}" BorderThickness="1"
            Background="{DynamicResource Shell.Brush.Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="CaptionText" Grid.Row="0" Margin="8,6,8,4"
                       Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                       TextWrapping="Wrap" />
            <Grid Grid.Row="1" ClipToBounds="True">
                <ScrollViewer x:Name="Viewport"
                              Background="{DynamicResource Shell.Brush.Surface}"
                              Cursor="SizeAll"
                              Focusable="False"
                              PanningMode="None"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              PreviewMouseWheel="OnViewportPreviewMouseWheel"
                              PreviewMouseLeftButtonDown="OnViewportPreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnViewportPreviewMouseMove"
                              PreviewMouseLeftButtonUp="OnViewportPreviewMouseLeftButtonUp"
                              LostMouseCapture="OnViewportLostMouseCapture"
                              ScrollChanged="OnScrollChanged"
                              SizeChanged="OnViewportSizeChanged">
                    <Canvas x:Name="GraphCanvas" Background="Transparent" />
                </ScrollViewer>
                <TextBlock x:Name="PlaceholderText"
                           Text="在项目总览中选择编号项目以查看提交图谱"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="16"
                           Foreground="{DynamicResource Shell.Brush.TextSecondary}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
