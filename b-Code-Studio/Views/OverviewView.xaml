<UserControl x:Class="HistoryJanus.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Shell.Brush.Surface}"
             Foreground="{DynamicResource Shell.Brush.TextPrimary}">
    <DockPanel Margin="6">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新项目"
                        Padding="12,3" Margin="8,0,0,0" Click="OnRefreshClick" />
                <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource Shell.Brush.TextSecondary}" />
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" TextChanged="OnSearchChanged" />
            </DockPanel>

            <ListView x:Name="WorktreeList"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      Background="{DynamicResource Shell.Brush.Surface}"
                      Foreground="{DynamicResource Shell.Brush.TextPrimary}"
                      BorderBrush="{DynamicResource Shell.Brush.Hairline}"
                      SelectionChanged="OnProjectSelected"
                      MouseDoubleClick="OnRowDoubleClick">
            <ListView.ItemContainerStyle>
                <!-- 本地模板复刻宿主 Shell.Item.Base 行为：选中 AccentSoft、悬停 SurfaceHover。
                     不用 BasedOn StaticResource 的原因：模块页在无宿主资源的环境(模块冒烟)也要可构造。 -->
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="6,1" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.TextPrimary}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <GridViewRowPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource Shell.Brush.SurfaceHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource Shell.Brush.AccentSoft}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Shell.Brush.TextPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{DynamicResource Shell.GridHeader}">
                    <GridViewColumn Header="#" Width="44" DisplayMemberBinding="{Binding Index}" />
                    <GridViewColumn Header="工作树" Width="58">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CleanStatusGlyph}"
                                           ToolTip="{Binding CleanStatusToolTip}"
                                           FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="分支 / 项目" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BranchDisplay}"
                                           ToolTip="{Binding BranchToolTip}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="元文件夹" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding PrimaryMetaName}"
                                            Tag="{Binding PrimaryMeta}"
                                            ToolTip="{Binding PrimaryMeta.FullPath}"
                                            IsEnabled="{Binding HasMeta}"
                                            Padding="4,0" MinHeight="0" BorderThickness="0"
                                            Background="Transparent"
                                            Foreground="{DynamicResource Shell.Brush.TextPrimary}"
                                            Click="OnMetaFolderClick" />
                                    <Button Content="{Binding MoreMetaLabel}"
                                            Margin="4,0,0,0" Padding="4,0" MinHeight="0"
                                            BorderThickness="0" Background="Transparent"
                                            Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                                            Click="OnMoreMetaClick">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAdditionalMeta}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="最近提交" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CommitDisplay}"
                                           ToolTip="{Binding LastCommitMessage}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
