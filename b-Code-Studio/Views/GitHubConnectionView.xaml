<UserControl x:Class="HistoryJanus.Views.GitHubConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Shell.Brush.Surface}"
             Foreground="{DynamicResource Shell.Brush.TextPrimary}">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8"
                  BorderBrush="{DynamicResource Shell.Brush.Hairline}"
                  BorderThickness="0">
        <StackPanel Background="{DynamicResource Shell.Brush.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="服务器 GitHub 连接" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ConnectionText" Grid.Column="1" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                           TextTrimming="CharacterEllipsis" />
                <WrapPanel Grid.Column="2">
                    <Button Content="检测" Click="OnTestClick" ToolTip="只读检测当前 origin 连接" />
                    <Button Content="诊断" Margin="8,0,0,0" Click="OnDiagnosticsClick"
                            ToolTip="弹出最近一次检测步骤" />
                    <Button Content="刷新" Margin="8,0,0,0" Click="OnRefreshClick" />
                </WrapPanel>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="origin" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="OriginText" Grid.Column="1" Margin="8,0,0,6"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="1" Text="最后检测" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="CheckedText" Grid.Row="1" Grid.Column="1" Margin="8,0,0,10"
                           Foreground="{DynamicResource Shell.Brush.TextSecondary}" />

                <TextBlock Grid.Row="2" Text="GCM 账号" Style="{StaticResource FieldLabel}" />
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                    <WrapPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button Content="登录" Click="OnLoginClick" />
                        <Button Content="注销所选" Margin="8,0,0,0" Click="OnLogoutClick" />
                    </WrapPanel>
                    <ComboBox x:Name="AccountsBox" DisplayMemberPath="Account" />
                </DockPanel>

                <TextBlock Grid.Row="3" Text="SSH 公钥" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="KeysBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                          SelectionChanged="OnKeySelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding FileName, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Algorithm, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="4" Text="user.name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="IdentityName" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" />

                <TextBlock Grid.Row="5" Text="user.email" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="IdentityEmail" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" />

                <TextBlock Grid.Row="6" Text="身份作用域" Style="{StaticResource FieldLabel}" />
                <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
                    <WrapPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button Content="预览身份" Click="OnIdentityPreviewClick" />
                        <Button Content="应用身份" Margin="8,0,0,0" Click="OnIdentityApplyClick" />
                    </WrapPanel>
                    <ComboBox x:Name="IdentityScope" SelectedIndex="0">
                        <ComboBoxItem Content="repository" />
                        <ComboBoxItem Content="global" />
                    </ComboBox>
                </DockPanel>

                <TextBlock Grid.Row="7" Text="身份来源" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="IdentitySourceText" Grid.Row="7" Grid.Column="1" Margin="8,0,0,10"
                           Foreground="{DynamicResource Shell.Brush.TextSecondary}" />

                <TextBlock Grid.Row="8" Text="Fetch URL" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="FetchUrl" Grid.Row="8" Grid.Column="1" Margin="0,0,0,6" />

                <TextBlock Grid.Row="9" Text="Push URL" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PushUrl" Grid.Row="9" Grid.Column="1" Margin="0,0,0,6" />

                <TextBlock Grid.Row="10" Text="仓库" Style="{StaticResource FieldLabel}" />
                <DockPanel Grid.Row="10" Grid.Column="1" Margin="0,0,0,0">
                    <WrapPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button Content="预览远端" Click="OnRemotePreviewClick" />
                        <Button Content="应用远端" Margin="8,0,0,0" Click="OnRemoteApplyClick" />
                    </WrapPanel>
                    <TextBlock x:Name="RepositoryText" VerticalAlignment="Center"
                               Foreground="{DynamicResource Shell.Brush.TextSecondary}" />
                </DockPanel>

                <TextBlock Grid.Row="11" Text="公钥指纹" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                <TextBlock x:Name="KeyFingerprintText" Grid.Row="11" Grid.Column="1" Margin="8,10,0,0"
                           Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                           TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
