    "overview": "b-Office/current/项目概览.md",
    "technicalContract": "b-Office/current/技术合同.md",
    "decisions": "b-Office/current/有效决策.md",
    "verification": "b-Office/current/验证合同.md"
  },
  "commands": {
    "setup": "dotnet restore .\\HistoryJanus.sln --locked-mode -p:NuGetAudit=false",
    "build": "dotnet build .\\HistoryJanus.sln -c Release --no-restore -p:NuGetAudit=false",
    "test": "dotnet test .\\b-Code-Verify\\Contracts\\Contracts.csproj -c Release -p:NuGetAudit=false",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\b-Code-Studio\\eng\\Test-QualityGate.ps1",
    "run": null,
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\b-Code-Studio\\eng\\Build-HistoryJanusPackage.ps1"
  },
  "externalDependencies": [
    "HistoryVulcan >= 5.4.0 host snapshot from ../2026-023-HistoryVulcan/z-Publish/host",
    "HistoryAurora >= 1.24.0 at runtime: content dialogs that carry action options (commit diff preview), stateful command buttons, bounded scrolling rule tables and scrollbar-free graph navigation; not a compile-time reference",
    ".NET 8 SDK and Windows Desktop Runtime",
    "Git command-line client"
  ],
  "contextExclusions": [
    "b-Office/history/**",
    "z-Publish/**",
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    "**/.vs/**",
    "artifacts/**"
  ],
  "publish": {
    "versionProps": "b-Code-Studio\\JanusVersion.props",
    "versionProperty": "HistoryJanusVersion",
    "sourceManifest": "b-Code-Studio\\Module\\module.manifest.json",
